NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
CORS_ORIGIN=*

# PostgreSQL + PostGIS Database Configuration
DATABASE_URL=postgres://i9_app_user:i9_app_password@localhost:5432/campus_run
MIGRATION_DATABASE_URL=postgres://i9_migrator:i9_migrator_password@localhost:5432/campus_run

DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000

# Game Engine Parameters
ROTATION_INTERVAL_MINUTES=45
MIN_SPAWN_DISTANCE_METERS=60
CLAIM_RADIUS_METERS=25
CONCURRENT_ACTIVE_SPAWNS=15
STREAK_GRACE_HOURS=24

# Authentication & Google OAuth Configuration
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
AUTH_COLLEGE_DOMAIN=campus.edu
JWT_SECRET=i9-dev-secret-32-chars-long-secure-key-123456
JWT_ACCESS_EXPIRATION_SECONDS=900
REFRESH_TOKEN_EXPIRATION_SECONDS=604800
